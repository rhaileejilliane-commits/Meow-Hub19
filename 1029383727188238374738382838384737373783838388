-- Hitbox Expander
local HitboxEnabled = false
local HitboxSize = 5
local originalPartSizes = {}

local function isR6(character)
    return character:FindFirstChild("Torso") ~= nil and character:FindFirstChild("HumanoidRootPart") ~= nil
end

local function applyHitboxToPlayer(p)
    if p == LocalPlayer then return end
    local char = p.Character
    if not char or not isR6(char) then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local torso = char:FindFirstChild("Torso")
    if hrp then
        if not originalPartSizes[hrp] then
            originalPartSizes[hrp] = {Size = hrp.Size, Transparency = hrp.Transparency, CanCollide = hrp.CanCollide}
        end
        hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
        hrp.Transparency = 1
        hrp.CanCollide = false
    end
    if torso then
        if not originalPartSizes[torso] then
            originalPartSizes[torso] = {Size = torso.Size, Transparency = torso.Transparency, CanCollide = torso.CanCollide}
        end
        torso.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
        torso.Transparency = 1
        torso.CanCollide = false
    end
end

local function resetHitboxForPlayer(p)
    local char = p.Character
    if not char then return end
    for _, partName in ipairs({"HumanoidRootPart", "Torso"}) do
        local part = char:FindFirstChild(partName)
        if part and originalPartSizes[part] then
            part.Size = originalPartSizes[part].Size
            part.Transparency = originalPartSizes[part].Transparency
            part.CanCollide = originalPartSizes[part].CanCollide
            originalPartSizes[part] = nil
        end
    end
end

Tabs.Combat:AddToggle("HitboxToggle", {
    Title = "Enable Hitbox Expander",
    Default = false,
    Callback = function(Value)
        HitboxEnabled = Value
        for _, p in ipairs(Players:GetPlayers()) do
            if HitboxEnabled then
                applyHitboxToPlayer(p)
            else
                resetHitboxForPlayer(p)
            end
        end
    end
})

Tabs.Combat:AddSlider("HitboxSlider", {
