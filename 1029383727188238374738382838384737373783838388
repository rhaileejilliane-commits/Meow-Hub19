})

RunService.Stepped:Connect(function()
    if not HitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if isR6(p.Character) then
                applyHitboxToPlayer(p)
            end
        end
    end
end)

-- Auto Flick System
local AutoFlickEnabled = false
local isFlicking = false
local lastTouchTimes = {}

Tabs.Combat:AddToggle("AutoFlickToggle", {
    Title = "Auto Flick",
    Default = false,
    Callback = function(Value)
        AutoFlickEnabled = Value
    end
})

RunService.Stepped:Connect(function()
    if not AutoFlickEnabled or isFlicking then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            if pRoot then
                local dist = (hrp.Position - pRoot.Position).Magnitude
                if dist <= 5 then
                    local currentTime = os.clock()
                    if not lastTouchTimes[p] or (currentTime - lastTouchTimes[p] > 1) then
                        lastTouchTimes[p] = currentTime
                        isFlicking = true
                        task.spawn(function()
                            local spinSpeed = 120
                            local accLeft = 0
                            while accLeft < 90 and AutoFlickEnabled do
                                local dt = RunService.RenderStepped:Wait()
                                local step = spinSpeed * dt * 60
                                if accLeft + step > 90 then step = 90 - accLeft end
                                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(step), 0)
                                accLeft = accLeft + step
                            end
                            local accRight = 0
                            while accRight < 90 and AutoFlickEnabled do
                                local dt = RunService.RenderStepped:Wait()
                                local step = spinSpeed * dt * 60
                                if accRight + step > 90 then step = 90 - accRight end
                                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(-spinSpeed), 0)
                                accRight = accRight + step
                            end
                            isFlicking = false
                        end)
                    end
                end
            end
        end
    end
end)

-- Auto Wallhop
local AutoWallhopEnabled = false
Tabs.Combat:AddToggle("AutoWallhopToggle", {
    Title = "Auto Wallhop",
    Default = false,
    Callback = function(Value)
        AutoWallhopEnabled = Value
    end
})

local function isTouchingWall(hrp)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.IgnoreWater = true
    local directions = {hrp.CFrame.LookVector, -hrp.CFrame.LookVector, hrp.CFrame.RightVector, -hrp.CFrame.RightVector}
    for _, dir in ipairs(directions) do
        local result = Workspace:Raycast(hrp.Position, dir * 2.2, raycastParams)
        if result and result.Instance and result.Instance.CanCollide and result.Instance.Transparency < 1 then
            return true
        end
    end
    return false
end

UserInputService.JumpRequest:Connect(function()
    if not AutoWallhopEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid or not isTouchingWall(hrp) then return end
    task.spawn(function()
        local spinSpeed = 90
        local acc = 0
        while acc < 90 and AutoWallhopEnabled do
            local dt = RunService.RenderStepped:Wait()
            local step = spinSpeed * dt * 60
            if acc + step > 90 then step = 90 - acc end
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(step), 0)
            acc = acc + step
        end
        acc = 0
        while acc < 90 and AutoWallhopEnabled do
            local dt = RunService.RenderStepped:Wait()
            local step = spinSpeed * dt * 60
            if acc + step > 90 then step = 90 - acc end
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(-step), 0)
            acc = acc + step
        end
    end)
end)

-- Auto Follow
local AutoFollowEnabled = false
Tabs.Combat:AddToggle("AutoFollowToggle", {
    Title = "Enable Auto Follow & Touch",
    Default = false,
    Callback = function(Value)
        AutoFollowEnabled = Value
    end
})

RunService.RenderStepped:Connect(function()
    if not AutoFollowEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp or humanoid.MoveDirection.Magnitude > 0.05 then return end

    local targetPlr = nil
    local shortestDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                targetPlr = p
            end
        end
    end

    if targetPlr and targetPlr.Character then
        local targetHrp = targetPlr.Character:FindFirstChild("HumanoidRootPart")
        if targetHrp then
            humanoid:MoveTo(targetHrp.Position)
        end
    end
end)

