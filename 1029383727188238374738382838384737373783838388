-- ESP
local ESPEnabled = false
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "FluentESPFolder"
ESPFolder.Parent = game:GetService("CoreGui")
local activeHighlights = {}

local function createESP(character)
    if activeHighlights[character] then return end
    local highlight = Instance.new("Highlight")
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 105, 180)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.Parent = ESPFolder
    activeHighlights[character] = highlight
end

local function removeESP(character)
    if activeHighlights[character] then
        activeHighlights[character]:Destroy()
        activeHighlights[character] = nil
    end
end

Tabs.Visual:AddToggle("ESPToggle", {
    Title = "Enable ESP",
    Default = false,
    Callback = function(Value)
        ESPEnabled = Value
        if ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    createESP(p.Character)
                end
            end
        else
            for char, _ in pairs(activeHighlights) do
                removeESP(char)
            end
        end
    end
})

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        if ESPEnabled then createESP(char) end
    end)
    player.CharacterRemoving:Connect(function(char)
        removeESP(char)
    end)
end)

-- FPS Booster
local FPSBoosterEnabled = false
local storedProperties = {}

Tabs.Visual:AddToggle("FPSBoosterToggle", {
    Title = "Enable FPS Booster",
    Default = false,
    Callback = function(Value)
        FPSBoosterEnabled = Value
        if FPSBoosterEnabled then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Decal") or obj:IsA("Texture") then
                    storedProperties[obj] = obj.Transparency
                    obj.Transparency = 1
                elseif obj:IsA("SpecialMesh") then
                    storedProperties[obj] = obj.TextureId
                    obj.TextureId = ""
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    storedProperties[obj] = obj.Enabled
                    obj.Enabled = false
                end
            end
            storedProperties["Ambient"] = Lighting.Ambient
            Lighting.Ambient = Color3.fromRGB(80, 60, 75)
        else
            for obj, prop in pairs(storedProperties) do
                if typeof(obj) == "Instance" and obj.Parent then
                    if obj:IsA("Decal") or obj:IsA("Texture") then
                        obj.Transparency = prop
                    elseif obj:IsA("SpecialMesh") then
                        obj.TextureId = prop
                    elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                        obj.Enabled = prop
                    end
                end
            end
            if storedProperties["Ambient"] then
                Lighting.Ambient = storedProperties["Ambient"]
            end
            storedProperties = {}
        end
    end
})

